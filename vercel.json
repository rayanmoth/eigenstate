{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "**"
    }
  },
  "rewrites": [
    { "source": "/(credentials|hardware|health|newgame|observe|resolve|scout|timing|turn)", "destination": "/api/index?__p=$1" }
  ]
}